{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cabinpi-react", //Remove -local before deployment
  "compatibility_date": "2026-09-09",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "cabinpi_db",
      "database_name": "cabinpi",
      "database_id": "c5b5bdc0-6237-4d78-a7b9-03509e614563",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "cabin-photos" }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://fphi.cloudflareaccess.com",
    "ACCESS_AUD": "e22e46957017da28ea77fb8f6f70af8665e36d1340841c9ce925103e36c4b46c"
  }
}
