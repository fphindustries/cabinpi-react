{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cabinpi-dashboard", // Distinct from the pre-existing "cabinpi-react"/"cabinpi-test" Workers on this account
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // "/api" (no suffix) must be listed alongside "/api/*": the glob alone does not
    // match the bare path, and single-page-application fallback would otherwise
    // serve index.html for it instead of the Worker's JSON 404.
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "cabinpi_db",
      "database_name": "cabinpi",
      "database_id": "c5b5bdc0-6237-4d78-a7b9-03509e614563",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "cabin-photos" }
  ],
  "images": { "binding": "IMAGES" },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://fphi.cloudflareaccess.com",
    "ACCESS_AUD": "e22e46957017da28ea77fb8f6f70af8665e36d1340841c9ce925103e36c4b46c"
  }
}
