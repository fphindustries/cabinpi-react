{
  "name": "cabinpi-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:functions": "wrangler pages dev --port 8788 --ip 127.0.0.1 dist",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "npm run build && wrangler pages dev --ip 127.0.0.1",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "node scripts/typegen.mjs",
    "test": "npm run build:functions && vitest run",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply cabinpi --local",
    "check": "npm run cf-typegen && npm run typecheck && npm run lint && npm test && npm run build",
    "build:functions": "wrangler pages functions build --outdir .wrangler/build",
    "dev:full": "npm run build && node scripts/dev.mjs"
  },
  "dependencies": {
    "@mantine/core": "^8.3.18",
    "@mantine/dates": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@tabler/icons-react": "^3.46.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "miniflare": "5.20260908.0-alpha",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "^0.35.4"
    }
  }
}
